local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local MAIN_SCRIPT_URL = "https://raw.githubusercontent.com/tienkhanh1/Aquavine/main/DivineHub"
local CUSTOM_INVITE_LINK = "xin chào"
local NEW_BRAND_TEXT = "Gau Mods"

local REPLACE_WORDS = {
	"divine"
}

-- Điền ID ảnh mới vào đây (hỗ trợ cả dạng số ID, "rbxassetid://...", hoặc đường dẫn "hash/file.png")
local IMAGE_REPLACEMENTS = {
	-- Ví dụ:
	-- ["d3f704ef886760905ab979d7cd87ac3b/logo.png"] = "rbxassetid://84033903679",
	-- ["3d0256c2b4114228c2fd0ba4619a9392/ChilliVenyx_logo_divine.png"] = "rbxassetid://84033903679",
	-- ["3d0256c2b4114228c2fd0ba4619a9392/ChilliVenyx_logo_discord.png"] = "rbxassetid://84033903679",
	-- ["97499770821177"] = "rbxassetid://84033903679",
}

local function normalizeTargetAsset(val)
	local s = tostring(val or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if s == "" then return nil end
	if s:match("^%d+$") then
		return "rbxassetid://" .. s
	end
	return s
end

local function extractDigits(str)
	local s = tostring(str or "")
	return s:match("(%d+)$") or s:match("(%d+)")
end

local TARGET_IMAGE_RULES = {}
for rawKey, rawVal in pairs(IMAGE_REPLACEMENTS) do
	local target = normalizeTargetAsset(rawVal)
	local kStr = tostring(rawKey or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if target and kStr ~= "" then
		table.insert(TARGET_IMAGE_RULES, {
			keyLower = kStr:lower(),
			digits = extractDigits(kStr),
			replacement = target,
		})
	end
end

local function matchImageReplacement(currentImage)
	local cur = tostring(currentImage or "")
	if cur == "" or #TARGET_IMAGE_RULES == 0 then return nil end
	local curLower = cur:lower()
	local curDigits = extractDigits(cur)

	for _, rule in ipairs(TARGET_IMAGE_RULES) do
		if curLower == rule.keyLower or curLower:find(rule.keyLower, 1, true) then
			return rule.replacement
		end
		if rule.digits and curDigits and rule.digits == rule.digits and curDigits == rule.digits then
			-- Tránh khớp nhầm rbxthumb avatar headshot
			if not curLower:find("avatarheadshot", 1, true) and curDigits == rule.digits then
				return rule.replacement
			end
		end
	end
	return nil
end

-- Hook setclipboard
pcall(function()
	local env = (getgenv and getgenv()) or _G
	if hookfunction and setclipboard and not env.__GauClipHooked then
		env.__GauClipHooked = true
		local oldClip
		oldClip = hookfunction(setclipboard, function(str)
			if type(str) == "string" then
				local low = str:lower()
				if low:find("discord.gg", 1, true)
					or low:find("discord.com/invite", 1, true)
					or low:find("wc4qdftyxx", 1, true)
					or low:find("nzubdu26ws", 1, true)
				then
					str = CUSTOM_INVITE_LINK
				end
			end
			return oldClip(str)
		end)
	end
end)

local function escapePattern(str)
	return tostring(str):gsub("([%%%^%$%(%)%.%[%]%*%+%-%?])", "%%%1")
end

local function makeCaseInsensitivePattern(word)
	local out = {}
	for i = 1, #word do
		local c = word:sub(i, i)
		if c:match("%a") then
			table.insert(out, "[" .. c:upper() .. c:lower() .. "]")
		else
			table.insert(out, escapePattern(c))
		end
	end
	return table.concat(out)
end

local COMPILED_PATTERNS = {}
for _, w in ipairs(REPLACE_WORDS) do
	if w and w ~= "" then
		table.insert(COMPILED_PATTERNS, makeCaseInsensitivePattern(w))
	end
end

local function transformText(rawText)
	local out = tostring(rawText or "")
	if out == "" then return out end

	out = out:gsub("https?://discord%.gg/[%w%-_]+", CUSTOM_INVITE_LINK)
	out = out:gsub("discord%.gg/[%w%-_]+", CUSTOM_INVITE_LINK)
	out = out:gsub("https?://discord%.com/invite/[%w%-_]+", CUSTOM_INVITE_LINK)

	local low = out:lower()
	if low:find("copied invite", 1, true)
		or low:find("copied discord", 1, true)
		or low:find("invite copied", 1, true)
		or low:find("đã sao chép link", 1, true)
	then
		out = "Đã sao chép link mời"
	end

	for _, pat in ipairs(COMPILED_PATTERNS) do
		out = out:gsub(pat, NEW_BRAND_TEXT)
	end

	return out
end

-- Xử lý nút bật/tắt menu: bấm 1 lần mở, bấm thêm 1 lần tắt hẳn ngay lập tức
local function findMainMenuTarget(clickedBtn)
	local rootGui = clickedBtn:FindFirstAncestorWhichIsA("ScreenGui")
	if not rootGui then return nil end

	-- Tìm khung chính lớn nhất (loại trừ nút toggle nhỏ)
	local bestFrame = nil
	local bestArea = 0
	for _, desc in ipairs(rootGui:GetDescendants()) do
		if desc:IsA("Frame") or desc:IsA("CanvasGroup") or desc:IsA("ScrollingFrame") then
			if desc ~= clickedBtn and not desc:IsAncestorOf(clickedBtn) and not clickedBtn:IsAncestorOf(desc) then
				local sz = desc.AbsoluteSize
				local area = sz.X * sz.Y
				if area > 12000 and area > bestArea then
					bestArea = area
					bestFrame = desc
				end
			end
		end
	end

	return bestFrame or rootGui
end

local function hookCleanToggle(btn)
	if not (btn:IsA("TextButton") or btn:IsA("ImageButton")) then return end
	if btn:GetAttribute("__GauCleanToggleHooked") then return end
	pcall(function() btn:SetAttribute("__GauCleanToggleHooked", true) end)

	local txt = tostring(btn.Text or ""):lower()
	local nameLow = tostring(btn.Name or ""):lower()
	local isSmallToggle = (btn.AbsoluteSize.X <= 90 and btn.AbsoluteSize.Y <= 90)
		or nameLow:find("toggle", 1, true)
		or nameLow:find("open", 1, true)
		or nameLow:find("minim", 1, true)
		or txt:find("open", 1, true)
		or txt:find("menu", 1, true)

	if not isSmallToggle then return end

	btn.Activated:Connect(function()
		task.defer(function()
			local target = findMainMenuTarget(btn)
			if not target then return end

			if target:IsA("ScreenGui") then
				target.Enabled = not target.Enabled
			elseif target:IsA("GuiObject") then
				local nextState = not target.Visible
				target.Visible = nextState
				local sg = target:FindFirstAncestorWhichIsA("ScreenGui")
				if sg and not sg.Enabled then
					sg.Enabled = true
				end
			end
		end)
	end)
end

local function patchObject(obj)
	if not obj or not obj.Parent then return end

	if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
		if not obj:GetAttribute("__GauBrandTextHooked") then
			pcall(function() obj:SetAttribute("__GauBrandTextHooked", true) end)
			local function applyText()
				local cur = tostring(obj.Text or "")
				local nextText = transformText(cur)
				if nextText ~= cur then
					obj.Text = nextText
				end
			end
			applyText()
			obj:GetPropertyChangedSignal("Text"):Connect(applyText)
		end
		if obj:IsA("TextButton") then
			pcall(hookCleanToggle, obj)
		end
	elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
		if not obj:GetAttribute("__GauBrandImgHooked") then
			pcall(function() obj:SetAttribute("__GauBrandImgHooked", true) end)
			local function applyImg()
				local cur = tostring(obj.Image or "")
				local nextImg = matchImageReplacement(cur)
				if nextImg and nextImg ~= cur then
					obj.Image = nextImg
				end
			end
			applyImg()
			obj:GetPropertyChangedSignal("Image"):Connect(applyImg)
		end
		if obj:IsA("ImageButton") then
			pcall(hookCleanToggle, obj)
		end
	end
end

local function watchRoot(root)
	if not root then return end
	for _, d in ipairs(root:GetDescendants()) do
		pcall(patchObject, d)
	end
	root.DescendantAdded:Connect(function(d)
		task.defer(function()
			pcall(patchObject, d)
			for _, sub in ipairs(d:GetDescendants()) do
				pcall(patchObject, sub)
			end
		end)
	end)
end

-- Quét định kỳ nhẹ cho ảnh để chống script gốc ghi đè lại sau khi tạo UI
task.spawn(function()
	while true do
		if #TARGET_IMAGE_RULES > 0 then
			for _, root in ipairs({ PlayerGui, gethui and gethui() or nil, game:GetService("CoreGui") }) do
				if root then
					for _, d in ipairs(root:GetDescendants()) do
						if d:IsA("ImageLabel") or d:IsA("ImageButton") then
							local nextImg = matchImageReplacement(d.Image)
							if nextImg and d.Image ~= nextImg then
								pcall(function() d.Image = nextImg end)
							end
						end
					end
				end
			end
		end
		task.wait(0.6)
	end
end)

pcall(function() watchRoot(PlayerGui) end)
pcall(function()
	if gethui then watchRoot(gethui()) end
end)
pcall(function()
	local cg = game:GetService("CoreGui")
	if cg then watchRoot(cg) end
end)

