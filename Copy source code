local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")

local CAPTURED_SCRIPTS = {}
local SEEN_KEYS = {}
local onCapturedCallback = nil

-- Nhận diện chính script lưu để không tự ghi vào danh sách xuất file
local SELF_TAG = "--[[ GAU_SAVE_SCRIPT_SELF ]]"

local function isSelfSource(str)
	if type(str) ~= "string" then
		return false
	end
	return string.find(str, SELF_TAG, 1, true) ~= nil
		or (string.find(str, "GauDumpSaveGui", 1, true) ~= nil and string.find(str, "buildDumpText", 1, true) ~= nil)
end

-- Key chống trùng lấy nhiều vị trí hơn để tránh trùng khi 2 script giống đầu/cuối
local function buildFingerprint(str)
	local s = tostring(str or "")
	local len = #s
	if len <= 240 then
		return tostring(len) .. ":" .. s
	end
	local mid = math.floor(len / 2)
	local q1 = math.floor(len / 4)
	local q3 = math.floor((len * 3) / 4)
	return table.concat({
		tostring(len),
		s:sub(1, 70),
		s:sub(q1, q1 + 40),
		s:sub(mid, mid + 40),
		s:sub(q3, q3 + 40),
		s:sub(len - 69, len),
	}, "|")
end

local function recordSource(sourceStr, tag)
	if type(sourceStr) ~= "string" or #sourceStr == 0 then
		return
	end
	if isSelfSource(sourceStr) then
		return
	end

	local key = buildFingerprint(sourceStr)
	if SEEN_KEYS[key] then
		return
	end
	SEEN_KEYS[key] = true

	table.insert(CAPTURED_SCRIPTS, {
		index = #CAPTURED_SCRIPTS + 1,
		tag = tag or "SOURCE",
		time = os.date("%H:%M:%S"),
		code = sourceStr,
	})

	if type(onCapturedCallback) == "function" then
		pcall(onCapturedCallback, #CAPTURED_SCRIPTS)
	end
end

-- Hook loadstring để bắt code chuỗi trước khi biên dịch/chạy
if hookfunction and loadstring then
	local oldLoadstring
	oldLoadstring = hookfunction(loadstring, function(chunk, ...)
		if type(chunk) == "string" and #chunk > 0 and not isSelfSource(chunk) then
			recordSource(chunk, "loadstring")
		end
		return oldLoadstring(chunk, ...)
	end)
end

-- Hook HttpGet để bắt nội dung tải về từ URL
if hookfunction and game.HttpGet then
	local oldHttpGet
	pcall(function()
		oldHttpGet = hookfunction(game.HttpGet, function(self, url, ...)
			local res = oldHttpGet(self, url, ...)
			if type(res) == "string" and #res > 0 and not isSelfSource(res) then
				recordSource(res, "HttpGet:" .. tostring(url))
			end
			return res
		end)
	end)
end

local function buildDumpText()
	if #CAPTURED_SCRIPTS == 0 then
		return ""
	end

	local parts = {
		"-- GAU MODS SOURCE DUMP",
		"-- Thời gian xuất: " .. os.date("%Y-%m-%d %H:%M:%S"),
		"-- Tổng số đoạn mã nguồn bắt được: " .. tostring(#CAPTURED_SCRIPTS),
		"",
	}

	for _, item in ipairs(CAPTURED_SCRIPTS) do
		table.insert(parts, "==========================================")
		table.insert(parts, string.format("-- [#%d] [%s] lúc %s (%d ký tự)", item.index, item.tag, item.time, #item.code))
		table.insert(parts, "==========================================")
		table.insert(parts, item.code)
		table.insert(parts, "")
	end

	return table.concat(parts, "\n")
end

local function getSaveFileFunc()
	return writefile or (syn and syn.write_file) or filewrite
end

local function sanitizeFileName(name)
	local clean = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
	clean = clean:gsub('[\\/:*?"<>|]', "_")
	return clean
end

local function saveTextToTxt(fileName, content)
	local writeFn = getSaveFileFunc()
	if not writeFn then
		return false, "Executor không hỗ trợ writefile."
	end

	local cleanName = sanitizeFileName(fileName)
	if cleanName == "" then
		return false, "Bạn phải đặt tên file trước khi lưu!"
	end

	if not cleanName:lower():match("%.txt$") then
		cleanName = cleanName .. ".txt"
	end

	local ok, err = pcall(function()
		writeFn(cleanName, tostring(content or ""))
	end)

	if ok then
		return true, "Đã lưu " .. tostring(#CAPTURED_SCRIPTS) .. " đoạn -> " .. cleanName
	end
	return false, "Lỗi lưu file: " .. tostring(err)
end

local function createFloatingSaveUI()
	local parentGui = (gethui and gethui()) or CoreGui
	pcall(function()
		local old = parentGui:FindFirstChild("GauDumpSaveGui")
		if old then
			old:Destroy()
		end
	end)

	local sg = Instance.new("ScreenGui")
	sg.Name = "GauDumpSaveGui"
	sg.ResetOnSpawn = false
	sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local placed = pcall(function()
		sg.Parent = parentGui
	end)
	if not placed or not sg.Parent then
		if not PlayerGui and LocalPlayer then
			PlayerGui = LocalPlayer:WaitForChild("PlayerGui", 5)
		end
		if PlayerGui then
			sg.Parent = PlayerGui
		end
	end

	local floatBtn = Instance.new("TextButton")
	floatBtn.Name = "FloatSaveButton"
	floatBtn.Size = UDim2.fromOffset(108, 34)
	floatBtn.Position = UDim2.new(0.02, 0, 0.5, 0)
	floatBtn.BackgroundColor3 = Color3.fromRGB(245, 185, 35)
	floatBtn.TextColor3 = Color3.fromRGB(25, 25, 25)
	floatBtn.Font = Enum.Font.GothamBold
	floatBtn.TextSize = 13
	floatBtn.Text = "💾 Lưu (" .. tostring(#CAPTURED_SCRIPTS) .. ")"
	floatBtn.Active = true
	floatBtn.BorderSizePixel = 0
	floatBtn.Parent = sg

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 8)
	btnCorner.Parent = floatBtn

	local btnStroke = Instance.new("UIStroke")
	btnStroke.Color = Color3.fromRGB(70, 40, 10)
	btnStroke.Thickness = 1.5
	btnStroke.Parent = floatBtn

	onCapturedCallback = function(total)
		if floatBtn and floatBtn.Parent then
			floatBtn.Text = "💾 Lưu (" .. tostring(total) .. ")"
		end
	end

	local modal = Instance.new("Frame")
	modal.Name = "NamePromptBox"
	modal.Size = UDim2.fromOffset(275, 145)
	modal.Position = UDim2.new(0.5, -137, 0.5, -72)
	modal.BackgroundColor3 = Color3.fromRGB(26, 28, 36)
	modal.BorderSizePixel = 0
	modal.Visible = false
	modal.Active = true
	modal.Parent = sg

	local modalCorner = Instance.new("UICorner")
	modalCorner.CornerRadius = UDim.new(0, 10)
	modalCorner.Parent = modal

	local modalStroke = Instance.new("UIStroke")
	modalStroke.Color = Color3.fromRGB(90, 140, 255)
	modalStroke.Thickness = 1.5
	modalStroke.Parent = modal

	local titleLbl = Instance.new("TextLabel")
	titleLbl.Size = UDim2.new(1, -20, 0, 26)
	titleLbl.Position = UDim2.new(0, 10, 0, 8)
	titleLbl.BackgroundTransparency = 1
	titleLbl.Text = "Đặt tên file mã nguồn (.txt)"
	titleLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	titleLbl.Font = Enum.Font.GothamBold
	titleLbl.TextSize = 13
	titleLbl.TextXAlignment = Enum.TextXAlignment.Left
	titleLbl.Parent = modal

	local nameBox = Instance.new("TextBox")
	nameBox.Size = UDim2.new(1, -20, 0, 34)
	nameBox.Position = UDim2.new(0, 10, 0, 38)
	nameBox.BackgroundColor3 = Color3.fromRGB(40, 43, 54)
	nameBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameBox.PlaceholderText = "Nhập tên file (bắt buộc)..."
	nameBox.PlaceholderColor3 = Color3.fromRGB(150, 155, 170)
	nameBox.Text = ""
	nameBox.ClearTextOnFocus = false
	nameBox.Font = Enum.Font.Gotham
	nameBox.TextSize = 13
	nameBox.BorderSizePixel = 0
	nameBox.Parent = modal

	local boxCorner = Instance.new("UICorner")
	boxCorner.CornerRadius = UDim.new(0, 6)
	boxCorner.Parent = nameBox

	local statusLbl = Instance.new("TextLabel")
	statusLbl.Size = UDim2.new(1, -20, 0, 18)
