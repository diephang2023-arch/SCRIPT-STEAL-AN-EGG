	statusLbl.BackgroundTransparency = 1
	statusLbl.Text = ""
	statusLbl.TextColor3 = Color3.fromRGB(255, 110, 110)
	statusLbl.Font = Enum.Font.Gotham
	statusLbl.TextSize = 11
	statusLbl.TextXAlignment = Enum.TextXAlignment.Left
	statusLbl.Parent = modal

	local cancelBtn = Instance.new("TextButton")
	cancelBtn.Size = UDim2.new(0.5, -14, 0, 32)
	cancelBtn.Position = UDim2.new(0, 10, 1, -40)
	cancelBtn.BackgroundColor3 = Color3.fromRGB(65, 68, 82)
	cancelBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	cancelBtn.Font = Enum.Font.GothamBold
	cancelBtn.TextSize = 13
	cancelBtn.Text = "Hủy"
	cancelBtn.BorderSizePixel = 0
	cancelBtn.Parent = modal

	local cancelCorner = Instance.new("UICorner")
	cancelCorner.CornerRadius = UDim.new(0, 6)
	cancelCorner.Parent = cancelBtn

	local confirmBtn = Instance.new("TextButton")
	confirmBtn.Size = UDim2.new(0.5, -14, 0, 32)
	confirmBtn.Position = UDim2.new(0.5, 4, 1, -40)
	confirmBtn.BackgroundColor3 = Color3.fromRGB(46, 175, 95)
	confirmBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	confirmBtn.Font = Enum.Font.GothamBold
	confirmBtn.TextSize = 13
	confirmBtn.Text = "Xác nhận lưu"
	confirmBtn.BorderSizePixel = 0
	confirmBtn.Parent = modal

	local confirmCorner = Instance.new("UICorner")
	confirmCorner.CornerRadius = UDim.new(0, 6)
	confirmCorner.Parent = confirmBtn

	local dragging, dragStart, startPos, moved = false, nil, nil, false

	floatBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			moved = false
			dragStart = input.Position
			startPos = floatBtn.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
			local delta = input.Position - dragStart
			if delta.Magnitude > 8 then
				moved = true
			end
			floatBtn.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			if dragging then
				dragging = false
				if not moved then
					statusLbl.Text = ""
					nameBox.Text = ""
					modal.Visible = not modal.Visible
					if modal.Visible then
						nameBox:CaptureFocus()
					end
				end
			end
		end
	end)

	cancelBtn.MouseButton1Click:Connect(function()
		modal.Visible = false
		statusLbl.Text = ""
	end)

	confirmBtn.MouseButton1Click:Connect(function()
		local typed = sanitizeFileName(nameBox.Text)
		if typed == "" then
			statusLbl.TextColor3 = Color3.fromRGB(255, 110, 110)
			statusLbl.Text = "Vui lòng nhập tên file trước!"
			nameBox:CaptureFocus()
			return
		end

		local dumpContent = buildDumpText()
		if dumpContent == "" then
			statusLbl.TextColor3 = Color3.fromRGB(255, 110, 110)
			statusLbl.Text = "Chưa bắt được mã nguồn nào!"
			return
		end

		local ok, msg = saveTextToTxt(typed, dumpContent)
		if ok then
			statusLbl.TextColor3 = Color3.fromRGB(95, 235, 135)
			statusLbl.Text = msg
			task.delay(0.8, function()
				if modal then
					modal.Visible = false
				end
			end)
		else
			statusLbl.TextColor3 = Color3.fromRGB(255, 110, 110)
			statusLbl.Text = msg
		end
	end)
end

createFloatingSaveUI()
